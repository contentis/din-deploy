+// Retain captures across shape changes without another ICudaEngine/weight allocation.
+// Opt-in through persistent workspace; the provider lock and single external stream
+// serialize all contexts that share that workspace. New shapes beyond the bounded
+// cache use the active context normally (and may recapture).
+static OrtStatus* SelectShapeContext(TensorrtRtxEpContextNodeComputeState& state,
+                                    TensorrtRtxExecutionProvider& ep, OrtKernelContext* ctx)
+{
+    if (!ep.IsPersistentContextMemoryEnabled() || !ep.IsGraphCaptureEnabled() || !ep.external_stream_)
+        return nullptr;
+    const auto& runtime_cache_path = ep.GetShapeContextRuntimeCachePath();
+    auto ort_ctx = Ort::KernelContext(ctx);
+    std::string key;
+    for (size_t i = 0; i < ort_ctx.GetInputCount(); ++i)
+    {
+        key += "/";
+        for (auto dim : ort_ctx.GetInput(i).GetTensorTypeAndShapeInfo().GetShape())
+            key += std::to_string(dim) + ",";
+    }
+    if (state.shape_contexts.empty())
+    {
+        auto initial = std::make_unique<CachedShapeContext>();
+        initial->context = state.context;
+        state.shape_contexts.emplace(key, std::move(initial));
+        state.active_shape = key;
+        return nullptr;
+    }
+    if (key == state.active_shape)
+        return nullptr;
+    auto found = state.shape_contexts.find(key);
+    if (found == state.shape_contexts.end())
+    {
+        if (state.shape_contexts.size() >= 16)
+            return nullptr;
+        auto config = std::unique_ptr<nvinfer1::IRuntimeConfig>((*state.engine)->createRuntimeConfig());
+        if (!config)
+            return ep.ort_api.CreateStatus(ORT_EP_FAIL, "Could not create shared-engine runtime configuration");
+        config->setDynamicShapesKernelSpecializationStrategy(nvinfer1::DynamicShapesKernelSpecializationStrategy::kEAGER);
+        config->setCudaGraphStrategy(nvinfer1::CudaGraphStrategy::kWHOLE_GRAPH_CAPTURE);
+        config->setExecutionContextAllocationStrategy(nvinfer1::ExecutionContextAllocationStrategy::kUSER_MANAGED);
+        std::filesystem::path cache_path;
+        std::unique_ptr<nvinfer1::IRuntimeCache> cache;
+        if (!runtime_cache_path.empty())
+        {
+            auto resolved = ResolveRuntimeCacheFile(runtime_cache_path,
+                state.fused_node_name + "_shape_" + std::to_string(std::hash<std::string>{}(key)), ep.logger_, ep.ort_api);
+            if (resolved)
+            {
+                cache_path = *resolved;
+                cache = CreateAndAttachRuntimeCache(*config, cache_path, ep.logger_, ep.ort_api);
+            }
+        }
+        auto context = CreateOwnedExecutionContext(**state.engine, cache_path, std::move(cache), std::move(config), ep.ort_api);
+        if (!context)
+            return ep.ort_api.CreateStatus(ORT_EP_FAIL, "Could not create shared-engine execution context");
+        if (ep.profiling_enable_)
+            context->setProfiler(ep.profiler_.get());
+        auto entry = std::make_unique<CachedShapeContext>();
+        entry->owned_context = std::make_unique<tensorrt_ptr::unique_pointer_exec_ctx>(std::move(context));
+        entry->context = entry->owned_context.get();
+        found = state.shape_contexts.emplace(key, std::move(entry)).first;
+    }
+    auto& previous = *state.shape_contexts.at(state.active_shape);
+    previous.input_tensors = std::move(state.input_tensors);
+    previous.output_tensors = std::move(state.output_tensors);
+    previous.scratch_buffers = std::move(state.scratch_buffers);
+    previous.is_first_run = state.is_first_run;
+    previous.skip_io_binding_allowed = state.skip_io_binding_allowed;
+    auto& next = *found->second;
+    state.context = next.context;
+    state.input_tensors = std::move(next.input_tensors);
+    state.output_tensors = std::move(next.output_tensors);
+    state.scratch_buffers = std::move(next.scratch_buffers);
+    state.is_first_run = next.is_first_run;
+    state.skip_io_binding_allowed = next.skip_io_binding_allowed;
+    state.active_shape = key;
+    return nullptr;
+}
